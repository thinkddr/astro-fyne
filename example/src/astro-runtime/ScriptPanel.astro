const description = ["Script", "module"].join(" ");
---
<section><p>{description}</p></section>
<script>
  import { next } from "./script-helper.ts";
  let count = 0;
  const button = document.getElementById("astro-js-script-increment")!;
  button.addEventListener("click", () => {
    count = next(count);
    document.getElementById("astro-js-script-count")!.textContent = String(count);
  });
</script>
