+#if defined(ATF_DIAGNOSTIC_SCALER_TRACE)
+// Passive diagnostics only: no changes to scaler requests, branches or pixels.
+void atf_trace_record(const char* stage, const void* identity,
+                      const SkScalerContextRec& rec) {
+    const SkString record = rec.dump();
+    std::fprintf(stderr, "ATF_SCALER stage=%s identity=%p hinting=%u\n%s",
+                 stage, identity, static_cast<unsigned>(rec.getHinting()), record.c_str());
+    std::fflush(stderr);
+}
+#define ATF_TRACE_RECORD(stage, identity, rec) atf_trace_record(stage, identity, rec)
+#define ATF_TRACE_BRANCH(branch) \
+    do { \
+        std::fprintf(stderr, "ATF_SCALER stage=hint-branch identity=%p branch=%s\n", \
+                     static_cast<const void*>(this), branch); \
+        std::fflush(stderr); \
+    } while (false)
+#else
+#define ATF_TRACE_RECORD(stage, identity, rec) ((void)0)
+#define ATF_TRACE_BRANCH(branch) ((void)0)
+#endif
