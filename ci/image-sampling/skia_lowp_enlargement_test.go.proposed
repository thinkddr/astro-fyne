package software

import (
	"image"
	"image/color"
	"testing"
)

// These expectations follow the pinned source arithmetic. They are not browser
// observations and cannot replace the independently captured Chromium corpus.
func TestSkiaLowpCandidateRoundsOddOpaqueTies(t *testing.T) {
	source := image.NewNRGBA(image.Rect(0, 0, 2, 1))
	source.SetNRGBA(0, 0, color.NRGBA{R: 1, G: 1, B: 1, A: 255})
	source.SetNRGBA(1, 0, color.NRGBA{R: 3, G: 3, B: 3, A: 255})
	for _, item := range []struct {
		factor int
		want []uint8
	}{
		{2, []uint8{1, 2, 3, 3}},
		{4, []uint8{1, 1, 1, 2, 2, 3, 3, 3}},
	} {
		actual, ok := skiaLowpEnlargement(source, 2*item.factor, item.factor)
		if !ok {
			t.Fatalf("factor %d was not supported", item.factor)
		}
		for y := 0; y < item.factor; y++ {
			for x, channel := range item.want {
				want := color.RGBA{R: channel, G: channel, B: channel, A: 255}
				if got := actual.RGBAAt(x, y); got != want {
					t.Fatalf("factor %d pixel (%d,%d): got %v, want %v", item.factor, x, y, got, want)
				}
			}
		}
	}
}

func TestSkiaLowpCandidatePremultipliesBeforeFiltering(t *testing.T) {
	source := image.NewNRGBA(image.Rect(0, 0, 2, 1))
	source.SetNRGBA(0, 0, color.NRGBA{R: 255, G: 1, B: 255, A: 0})
	source.SetNRGBA(1, 0, color.NRGBA{R: 1, G: 3, B: 5, A: 255})
	actual, ok := skiaLowpEnlargement(source, 4, 2)
	if !ok {
		t.Fatal("RGBA8 two-times enlargement was not supported")
	}
	want := []color.RGBA{
		{},
		{R: 0, G: 1, B: 1, A: 64},
		{R: 1, G: 2, B: 4, A: 191},
		{R: 1, G: 3, B: 5, A: 255},
	}
	for y := 0; y < 2; y++ {
		for x, expected := range want {
			if got := actual.RGBAAt(x, y); got != expected {
				t.Fatalf("pixel (%d,%d): got premultiplied %v, want %v", x, y, got, expected)
			}
		}
	}
}

func TestSkiaLowpCandidateRetainsTwoAxisIntermediatePrecision(t *testing.T) {
	source := image.NewRGBA(image.Rect(0, 0, 2, 2))
	for index, channel := range []uint8{1, 4, 5, 2} {
		source.SetRGBA(index%2, index/2, color.RGBA{R: channel, G: channel, B: channel, A: 255})
	}
	actual, ok := skiaLowpEnlargement(source, 4, 4)
	if !ok {
		t.Fatal("opaque RGBA8 enlargement was not supported")
	}
	want := [4][4]uint8{
		{1, 2, 3, 4},
		{2, 2, 3, 4},
		{4, 4, 3, 3},
		{5, 4, 3, 2},
	}
	for y, row := range want {
		for x, channel := range row {
			expected := color.RGBA{R: channel, G: channel, B: channel, A: 255}
			if got := actual.RGBAAt(x, y); got != expected {
				t.Fatalf("pixel (%d,%d): got %v, want %v", x, y, got, expected)
			}
		}
	}
}

func TestSkiaLowpCandidateRetainsLowAlphaQuantization(t *testing.T) {
	for _, item := range []struct {
		channel uint8
		want color.RGBA
	}{
		{127, color.RGBA{A: 1}},
		{128, color.RGBA{R: 1, G: 1, B: 1, A: 1}},
	} {
		source := image.NewNRGBA(image.Rect(0, 0, 1, 1))
		source.SetNRGBA(0, 0, color.NRGBA{R: item.channel, G: item.channel, B: item.channel, A: 1})
		actual, ok := skiaLowpEnlargement(source, 2, 2)
		if !ok {
			t.Fatal("constant low-alpha source was not supported")
		}
		for y := 0; y < 2; y++ {
			for x := 0; x < 2; x++ {
				if got := actual.RGBAAt(x, y); got != item.want {
					t.Fatalf("channel %d pixel (%d,%d): got %v, want %v", item.channel, x, y, got, item.want)
				}
			}
		}
	}
}

func TestSkiaLowpCandidateDeclinesOtherProfiles(t *testing.T) {
	source := image.NewNRGBA(image.Rect(0, 0, 2, 2))
	for _, size := range []image.Point{{2, 2}, {6, 6}, {4, 8}, {5, 5}, {0, 4}} {
		if _, ok := skiaLowpEnlargement(source, size.X, size.Y); ok {
			t.Fatalf("unsupported destination %v was accepted", size)
		}
	}
	partial := image.NewRGBA(image.Rect(0, 0, 1, 1))
	partial.SetRGBA(0, 0, color.RGBA{R: 1, A: 1})
	if _, ok := skiaLowpEnlargement(partial, 2, 2); ok {
		t.Fatal("partially transparent premultiplied source lost its straight-byte provenance")
	}
	shifted := image.NewNRGBA(image.Rect(1, 1, 3, 3))
	if _, ok := skiaLowpEnlargement(shifted, 4, 4); ok {
		t.Fatal("nonzero source origin was accepted")
	}
}
