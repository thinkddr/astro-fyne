package software

import (
	"bytes"
	"image"
	"image/color"
	imageDraw "image/draw"
	"testing"

	"fyne.io/fyne/v2/canvas"
)

func TestSkiaLegacyScopePreservesOriginalSamplingOutsideProfile(t *testing.T) {
	source := image.NewNRGBA(image.Rect(0, 0, 2, 2))
	for i, pixel := range []color.NRGBA{
		{R: 0, G: 1, B: 127, A: 255},
		{R: 3, G: 129, B: 201, A: 17},
		{R: 63, G: 254, B: 5, A: 127},
		{R: 255, G: 47, B: 89, A: 255},
	} {
		source.SetNRGBA(i%2, i/2, pixel)
	}
	nonzero := image.NewNRGBA(image.Rect(1, 1, 3, 3))
	imageDraw.Draw(nonzero, nonzero.Bounds(), source, image.Point{}, imageDraw.Src)
	partialRGBA := image.NewRGBA(source.Bounds())
	imageDraw.Draw(partialRGBA, partialRGBA.Bounds(), source, image.Point{}, imageDraw.Src)
	sixteenBit := image.NewNRGBA64(source.Bounds())
	imageDraw.Draw(sixteenBit, sixteenBit.Bounds(), source, image.Point{}, imageDraw.Src)
	for _, item := range []struct {
		name string
		source image.Image
		width, height int
		mode canvas.ImageScale
		alpha float64
		radius float32
	}{
		{"pixels", source, 4, 4, canvas.ImageScalePixels, 1, 0},
		{"fastest", source, 4, 4, canvas.ImageScaleFastest, 1, 0},
		{"factor-three", source, 6, 6, canvas.ImageScaleSmooth, 1, 0},
		{"nonuniform", source, 4, 8, canvas.ImageScaleSmooth, 1, 0},
		{"shrinking", source, 1, 1, canvas.ImageScaleSmooth, 1, 0},
		{"partial-object-alpha", source, 4, 4, canvas.ImageScaleSmooth, 0.5, 0},
		{"rounded", source, 4, 4, canvas.ImageScaleSmooth, 1, 1},
		{"small-radius", source, 4, 4, canvas.ImageScaleSmooth, 1, 0.25},
		{"nonzero-bounds", nonzero, 4, 4, canvas.ImageScaleSmooth, 1, 0},
		{"premultiplied-translucent", partialRGBA, 4, 4, canvas.ImageScaleSmooth, 1, 0},
		{"sixteen-bit", sixteenBit, 4, 4, canvas.ImageScaleSmooth, 1, 0},
	} {
		t.Run(item.name, func(t *testing.T) {
			actual := legacyScopeCanvas(item.width, item.height)
			drawPixels(0, 0, item.width, item.height, item.mode, actual, item.source, actual.Bounds(), item.alpha, item.radius, true)
			want := legacyScopeCanvas(item.width, item.height)
			drawPixels(0, 0, item.width, item.height, item.mode, want, item.source, want.Bounds(), item.alpha, item.radius, false)
			if !bytes.Equal(actual.Pix, want.Pix) {
				t.Fatal("changed the original sampling path outside the supported image profile")
			}
		})
	}
}

func legacyScopeCanvas(width, height int) *image.NRGBA {
	result := image.NewNRGBA(image.Rect(0, 0, width, height))
	imageDraw.Draw(result, result.Bounds(), image.White, image.Point{}, imageDraw.Src)
	return result
}
