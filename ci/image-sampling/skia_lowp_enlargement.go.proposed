// The fixed-point interpolation is derived from Skia's LOWP bilerp_clamp_8888
// at 9d07e5bad9e3e21da2426946e589daa647218271. Retain LICENSE-Skia.txt and
// LICENSE-Fyne.txt when distributing this experimental candidate.

package software

import (
	"image"
	"image/color"
)

// skiaLowpEnlargement is an unverified, source-derived CPU-profile candidate.
// It deliberately accepts only uniform physical enlargement factors 2 and 4,
// zero-origin NRGBA8 or opaque RGBA8 sources, and bounded output dimensions.
// A false result leaves the caller's existing path responsible for the image.
// Matching this arithmetic does not prove which path Chromium actually uses.
func skiaLowpEnlargement(source image.Image, width, height int) (*image.RGBA, bool) {
	if source == nil || width <= 0 || height <= 0 || width > 16384 || height > 16384 || width > (64*1024*1024)/height {
		return nil, false
	}
	bounds := source.Bounds()
	if bounds.Min != (image.Point{}) || bounds.Dx() <= 0 || bounds.Dy() <= 0 || width%bounds.Dx() != 0 || height%bounds.Dy() != 0 {
		return nil, false
	}
	factor := width / bounds.Dx()
	if (factor != 2 && factor != 4) || height/bounds.Dy() != factor {
		return nil, false
	}
	var load func(int, int) color.RGBA
	switch pixels := source.(type) {
	case *image.NRGBA:
		load = func(x, y int) color.RGBA {
			pixel := pixels.NRGBAAt(x, y)
			return color.RGBA{
				R: skiaPremultiply8(pixel.R, pixel.A),
				G: skiaPremultiply8(pixel.G, pixel.A),
				B: skiaPremultiply8(pixel.B, pixel.A),
				A: pixel.A,
			}
		}
	case *image.RGBA:
		// A partially transparent RGBA image may already have lost the source's
		// straight color bytes. Do not pretend a second conversion recovers them.
		if !pixels.Opaque() {
			return nil, false
		}
		load = pixels.RGBAAt
	default:
		return nil, false
	}
	premultiplied := image.NewRGBA(bounds)
	for y := 0; y < bounds.Dy(); y++ {
		for x := 0; x < bounds.Dx(); x++ {
			premultiplied.SetRGBA(x, y, load(x, y))
		}
	}
	clamp := func(index, maximum int) int {
		if index < 0 {
			return 0
		}
		if index >= maximum {
			return maximum - 1
		}
		return index
	}
	result := image.NewRGBA(image.Rect(0, 0, width, height))
	for y := 0; y < height; y++ {
		sy, ty := skiaLowpCoordinate(y, factor)
		y0, y1 := clamp(sy, bounds.Dy()), clamp(sy+1, bounds.Dy())
		for x := 0; x < width; x++ {
			sx, tx := skiaLowpCoordinate(x, factor)
			x0, x1 := clamp(sx, bounds.Dx()), clamp(sx+1, bounds.Dx())
			tl := premultiplied.RGBAAt(x0, y0)
			tr := premultiplied.RGBAAt(x1, y0)
			bl := premultiplied.RGBAAt(x0, y1)
			br := premultiplied.RGBAAt(x1, y1)
			result.SetRGBA(x, y, color.RGBA{
				R: skiaLowpChannel(tl.R, tr.R, bl.R, br.R, tx, ty),
				G: skiaLowpChannel(tl.G, tr.G, bl.G, br.G, tx, ty),
				B: skiaLowpChannel(tl.B, tr.B, bl.B, br.B, tx, ty),
				A: skiaLowpChannel(tl.A, tr.A, bl.A, br.A, tx, ty),
			})
		}
	}
	return result, true
}

func skiaPremultiply8(channel, alpha uint8) uint8 {
	return uint8((uint32(channel)*uint32(alpha) + 127) / 255)
}

func skiaLowpCoordinate(destination, factor int) (int, int16) {
	// q = floor(65536 * ((d + 0.5) / factor) + 0.5) - 32768.
	// For factors 2 and 4 the product is already an exact integer, so no float
	// or approximate reciprocal enters this restricted coordinate calculation.
	q := (int64(2*destination+1)*32768)/int64(factor) - 32768
	return int(q >> 16), int16(uint16(q) ^ 0x8000)
}

func skiaLowpMultiply(a, b int16) int32 {
	// Matches Skia's x86 PMULHRSW, ARM64/NEON VQRDMULH and scalar scaled_mult
	// in this bounded range. Interpolation widths stay within +/-32640, so the
	// exceptional (-32768, -32768) pair and its saturation difference cannot occur.
	return (int32(a)*int32(b) + (1 << 14)) >> 15
}

func skiaLowpLerpX(left, right uint8, fraction int16) uint16 {
	width := int16((int32(right) - int32(left)) << 7)
	middle := (int32(right) + int32(left)) << 7
	return uint16((skiaLowpMultiply(fraction, width) + middle + 1) >> 1)
}

func skiaLowpChannel(tl, tr, bl, br uint8, tx, ty int16) uint8 {
	top := skiaLowpLerpX(tl, tr, tx)
	bottom := skiaLowpLerpX(bl, br, tx)
	width := int16(int32(bottom) - int32(top))
	middle := int32(bottom) + int32(top)
	return uint8((skiaLowpMultiply(ty, width) + middle + 0x80) >> 8)
}
