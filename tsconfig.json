{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "capture/**/*.ts",
    "ci/program-roundtrip.ts",
    "ci/javascript-roundtrip.ts",
    "ci/javascript-pointer-roundtrip.ts",
    "ci/cli-page-roundtrip.ts",
    "ci/css-roundtrip.ts",
    "ci/css-has-roundtrip.ts",
    "ci/css-height-roundtrip.ts",
    "ci/catalogue-roundtrip.ts",
    "ci/unicode-font-family.ts",
    "ci/text-engine-probe/*.ts",
    "example/src/components/**/*.tsx",
    "example/src/pages/**/*.tsx"
  ]
}
